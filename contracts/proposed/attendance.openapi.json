  "info": {
    "title": "PROPOSED academic attendance contract",
    "version": "0.0.0-proposed"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/attendance-sessions/{session_id}/records/{enrollment_id}": {
      "put": {
        "operationId": "put_attendance_record_api_v1_attendance_sessions__session_id__records__enrollment_id__put",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Session Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "enrollment_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Enrollment Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AttendanceRecordWrite"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttendanceRecordOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttendanceRecordOut"
                }
              }
            },
            "description": "Primer registro creado"
          },
          "403": {
            "description": "Sin permiso o fuera de ámbito (explicado y auditado)"
          },
          "404": {
            "description": "Sesión o matrícula no encontrada"
          },
          "409": {
            "description": "Versión desfasada, sesión futura o matrícula no activa"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "description": "Persistencia no habilitada"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Registrar o corregir asistencia con versión esperada e historial",
        "tags": [
          "attendance"
        ]
      }
    },
    "/api/v1/cohorts/{cohort_id}/attendance-sessions": {
      "post": {
        "operationId": "create_attendance_session_api_v1_cohorts__cohort_id__attendance_sessions_post",
        "parameters": [
          {
            "in": "path",
            "name": "cohort_id",
            "required": true,
            "schema": {
              "title": "Cohort Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AttendanceSessionCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttendanceSessionOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "description": "Sin permiso o fuera de ámbito (explicado y auditado)"
          },
          "404": {
            "description": "Cohorte no encontrada"
          },
          "409": {
            "description": "Sesión duplicada o solapada"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "description": "Persistencia no habilitada"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Preparar una sesión lectiva de la cohorte, sin convertir registros ausentes en asistencia",
        "tags": [
          "attendance"
        ]
      }
    },
    "/api/v1/enrollments/{enrollment_id}/attendance-summary": {
      "get": {
        "description": "No interpreta un registro ausente como cero faltas. El ámbito se deriva de la matrícula y la sesión autenticada, nunca del modelo.",
        "operationId": "read_attendance_summary_api_v1_enrollments__enrollment_id__attendance_summary_get",
        "parameters": [
          {
            "in": "path",
            "name": "enrollment_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Enrollment Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "date_from",
            "required": true,
            "schema": {
              "format": "date",
              "title": "Date From",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "date_to",
            "required": true,
            "schema": {
              "format": "date",
              "title": "Date To",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttendanceSummary"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Sesión no válida"
          },
          "403": {
            "description": "Sin permiso académico o matrícula fuera de ámbito (explicado y auditado)"
          },
          "404": {
            "description": "Matrícula no encontrada"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "description": "Persistencia académica no habilitada"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Resumen de asistencia registrado, con periodo, cobertura y datos desconocidos",
        "tags": [
          "attendance"
        ]
      }
    }
  },
  "x-status": "PROPOSED_NOT_MOUNTED"
}
