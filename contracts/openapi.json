  "info": {
    "description": "API del Proyecto Final 2 · Fundación Somos F5. **Datos exclusivamente sintéticos.** La autorización se comprueba en el servidor por rol y ámbito (programa, convocatoria o cohorte). La plataforma no toma decisiones automáticas de admisión, exclusión ni baja.",
    "title": "Gistar API (nombre provisional)",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/applications": {
      "get": {
        "operationId": "list_applications_api_v1_applications_get",
        "parameters": [
          {
            "in": "query",
            "name": "call_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Call Id"
            }
          },
          {
            "in": "query",
            "name": "stage",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "enviada",
                    "requisitos_en_revision",
                    "convocada",
                    "evaluacion_en_curso",
                    "pendiente_decision_humana",
                    "admitida",
                    "lista_espera",
                    "no_admitida",
                    "retirada"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Stage"
            }
          },
          {
            "description": "Busca por nombre, correo o código",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 80,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Busca por nombre, correo o código",
              "title": "Q"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationList"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Expedientes dentro del ámbito del usuario (captación / selección / administración)",
        "tags": [
          "admissions"
        ]
      },
      "post": {
        "operationId": "post_application_api_v1_applications_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApplicationCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
