# Copy to infra/.env (git-ignored) and set a strong random value.
# Example generation (PowerShell):
#   $b = New-Object byte[] 24; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b)
#   ($b | ForEach-Object { $_.ToString('x2') }) -join ''
# Never commit the real value. / Nunca subas el valor real.
GISTAR_DB_PASSWORD=replace-with-a-long-random-value
