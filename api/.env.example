# Gistar API environment — safe example values. Copy to .env and adjust.
# Never commit a real .env; .env* is gitignored. Synthetic/local credentials only.

# Local development database. Replace <GISTAR_DB_PASSWORD> with the value you
# set in infra/.env (see infra/.env.example for how to generate it).
GISTAR_DATABASE_URL=postgresql+psycopg://gistar:<GISTAR_DB_PASSWORD>@localhost:5432/gistar

# Test database used by pytest (created by infra/initdb/01-test-db.sql)
GISTAR_TEST_DATABASE_URL=postgresql+psycopg://gistar:<GISTAR_DB_PASSWORD>@localhost:5432/gistar_test

# Allowed browser origins for the web app
GISTAR_CORS_ORIGINS=["http://localhost:5173","http://localhost:8443"]

# Password for the synthetic demo accounts listed in api/README.md.
# Rotate to a non-default value before any deployment.
GISTAR_DEMO_PASSWORD=gistar-demo-2026
