# EduGest API environment — safe example values. Copy to .env and adjust.
# Never commit a real .env; .env* is gitignored. Synthetic/local credentials only.

# Local development database. Replace <GISTAR_DB_PASSWORD> with the value you
# set in infra/.env (see infra/.env.example for how to generate it).
GISTAR_DATABASE_URL=postgresql+psycopg://gistar:<GISTAR_DB_PASSWORD>@localhost:5432/gistar

# Test database used by pytest (created by infra/initdb/01-test-db.sql)
GISTAR_TEST_DATABASE_URL=postgresql+psycopg://gistar:<GISTAR_DB_PASSWORD>@localhost:5432/gistar_test

# Allowed browser origins for the web app
GISTAR_CORS_ORIGINS=["http://localhost:5173","http://localhost:8443"]

# Runtime environment: local, staging or production. Anything but local refuses to start with the default
# demo password or database URL. / Cualquier valor distinto de local rechaza el arranque con credenciales por defecto.
GISTAR_ENVIRONMENT=local

# Password for the synthetic demo accounts listed in api/README.md.
# Set a strong, environment-specific value before starting the API or loading the seed.
# Define un valor seguro y distinto por entorno antes de arrancar o cargar el seed.
GISTAR_DEMO_PASSWORD=

# GitHub read-only consumer (YO9). Optional: leave it empty to call GitHub without a token (60 requests/hour).
# If you set one, it must only have read access to public repositories (no write scopes, no private repos).
# GISTAR_GITHUB_TOKEN=
